// Quest Attestation Contract for Midnight Network
// Records quest completion on-chain without revealing personal data
// Ledger 8 compatible (Compact 0.31.1)

import CompactStandardLibrary;

// Public ledger state
// Commitments: Historic Merkle tree of all recorded quest completion commitments
// Only the tree root is disclosed on-chain, not individual commitments
// 32-level tree supports 2^32 commitments
export ledger commitments: HistoricMerkleTree<32, Bytes<32>>;

// Nullifiers: Set of nullifiers to prevent duplicate attestations  
export ledger nullifiers: Set<Bytes<32>>;

// Counter: total number of recorded quest attestations
export ledger counter: Counter;

// Witness for quest ID (private input)
witness questId(): Bytes<32>;

// Witness for version (private input)
witness versionNum(): Uint<16>;

// Witness for user secret (private input for commitment)
witness userSecret(): Bytes<32>;

// Witness for local secret key (private input for nullifier)
witness localSecretKey(): Bytes<32>;

// Witness for salt (private input)
witness saltValue(): Bytes<32>;

// Witness for Merkle path (for checkAttestation)
// Provides the full path including leaf and sibling hashes
witness merklePath(): MerkleTreePath<32, Bytes<32>>;

// Helper circuit to compute commitment
circuit computeCommitment(qId: Bytes<32>, ver: Uint<16>, secret: Bytes<32>, s: Bytes<32>): Bytes<32> {
  const verBytes = pad(32, "midnight:quest:commitment") as Bytes<32>;
  return persistentHash<Vector<5, Bytes<32>>>([verBytes, qId, secret, s, (ver as Uint<32>) as Bytes<32>]);
}

// Helper circuit to derive nullifier from local secret key and quest ID
circuit deriveNullifier(qId: Bytes<32>, localKey: Bytes<32>): Bytes<32> {
  const domainSep = pad(32, "midnight:quest:nullifier") as Bytes<32>;
  return persistentHash<Vector<3, Bytes<32>>>([domainSep, localKey, qId]);
}

// Circuit to record a quest attestation
// Derives nullifier internally from witnesses
export circuit recordQuest(): [] {
  const qId = questId();
  const ver = versionNum();
  const secret = userSecret();
  const localKey = localSecretKey();
  const s = saltValue();
  
  // Compute commitment as hash of all private inputs
  const comm = computeCommitment(qId, ver, secret, s);
  
  // Derive nullifier from local secret key and quest ID (prevents double recording)
  const nullifier = deriveNullifier(qId, localKey);
  
  // Check nullifier hasn't been used (no double recording)
  assert(!nullifiers.member(disclose(nullifier)), "Quest already recorded by this user");
  
  // Record commitment and nullifier on public ledger
  commitments.insert(disclose(comm));
  nullifiers.insert(disclose(nullifier));
  
  // Increment counter
  counter.increment(1);
}

// Circuit for unlinkable attestation disclosure
// Uses Merkle path witness to check commitment without disclosing it on-chain
// Only the tree root and challenge-bound response are disclosed
export circuit checkAttestation(challenge: Bytes<32>, qId: Bytes<32>): Bytes<32> {
  const ver = versionNum();
  const secret = userSecret();
  const s = saltValue();
  const path = merklePath();
  
  // Recompute commitment from private inputs and public qId
  const comm = computeCommitment(qId, ver, secret, s);
  
  // Compute Merkle root from path (in zero-knowledge)
  // The path contains the commitment as its leaf
  const root = merkleTreePathRoot<32, Bytes<32>>(path);
  
  // Check root against ledger (only root is disclosed, not the commitment)
  assert(commitments.checkRoot(disclose(root)), "Attestation not found");
  
  // Return ONLY a blinded response bound to challenge and qId
  // Neither the commitment nor individual tree nodes are disclosed
  const domainSep = pad(32, "midnight:quest:response") as Bytes<32>;
  const response = persistentHash<Vector<4, Bytes<32>>>([domainSep, secret, challenge, qId]);
  
  return disclose(response);
}

// Query circuit to check if a nullifier has been used
export circuit hasNullifier(n: Bytes<32>): Boolean {
  return nullifiers.member(disclose(n));
}

// Query circuit to get current counter value
export circuit getCounterValue(): Field {
  return counter;
}
