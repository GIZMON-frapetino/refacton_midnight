// QuestAttestation: private record membership against the current tree root.
// Compact 0.31.1, Ledger 8.0.2, runtime 0.16.0.
import CompactStandardLibrary;

export ledger commitments: MerkleTree<16, Bytes<32>>;
export ledger nullifiers: Set<Bytes<32>>;
export ledger counter: Counter;

witness questId(): Bytes<32>;
witness versionNum(): Uint<16>;
witness userSecret(): Bytes<32>;
witness localSecretKey(): Bytes<32>;
witness saltValue(): Bytes<32>;
witness commitmentPath(comm: Bytes<32>): MerkleTreePath<16, Bytes<32>>;

circuit computeCommitment(qId: Bytes<32>, ver: Uint<16>, secret: Bytes<32>, s: Bytes<32>): Bytes<32> {
  const domain = pad(32, "midnight:quest:commitment") as Bytes<32>;
  return persistentHash<Vector<5, Bytes<32>>>([domain, qId, secret, s, (ver as Uint<32>) as Bytes<32>]);
}

circuit deriveNullifier(qId: Bytes<32>, localKey: Bytes<32>): Bytes<32> {
  const domain = pad(32, "midnight:quest:nullifier") as Bytes<32>;
  return persistentHash<Vector<3, Bytes<32>>>([domain, localKey, qId]);
}

export circuit recordQuest(): [] {
  const qId = questId();
  const comm = computeCommitment(qId, versionNum(), userSecret(), saltValue());
  const nullifier = deriveNullifier(qId, localSecretKey());
  assert(!nullifiers.member(disclose(nullifier)), "Quest already recorded by this user");
  commitments.insert(disclose(comm));
  nullifiers.insert(disclose(nullifier));
  counter.increment(1);
}

// The path and its leaf stay private; only its root enters the ledger query.
// The quest ID is a witness too, not a repeated public check argument.
export circuit checkAttestation(challenge: Bytes<32>): Bytes<32> {
  const qId = questId();
  const secret = userSecret();
  const comm = computeCommitment(qId, versionNum(), secret, saltValue());
  const path = commitmentPath(comm);
  assert(path.leaf == comm, "Path is not for this record");
  const root = merkleTreePathRoot<16, Bytes<32>>(path);
  assert(commitments.checkRoot(disclose(root)), "Attestation not found");
  const domain = pad(32, "midnight:quest:response") as Bytes<32>;
  return disclose(persistentHash<Vector<4, Bytes<32>>>([domain, secret, challenge, qId]));
}

export circuit hasNullifier(n: Bytes<32>): Boolean {
  return nullifiers.member(disclose(n));
}

export circuit getCounterValue(): Field {
  return counter;
}
