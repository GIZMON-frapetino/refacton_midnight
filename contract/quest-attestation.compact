// Quest Attestation Contract for Midnight Network
// Records quest completion on-chain without revealing personal data
// Ledger 8 compatible (Compact 0.31.1)

import CompactStandardLibrary;

// Public ledger state
// Commitment: hash representing a quest completion
export ledger commitment: Bytes<32>;

// Nullifier: prevents duplicate attestation records
export ledger nullifier: Bytes<32>;

// Counter: total number of recorded quest attestations
export ledger counter: Counter;

// Flag to indicate if the current slot is used
export ledger isSet: Boolean;

// Witness for quest ID (private input)
witness questId(): Bytes<32>;

// Witness for version (private input)
witness versionNum(): Uint<16>;

// Witness for user secret (private input)
witness userSecret(): Bytes<32>;

// Witness for salt (private input)
witness saltValue(): Bytes<32>;

// Helper circuit to compute commitment using persistent hash
circuit computeCommitment(qId: Bytes<32>, ver: Uint<16>, secret: Bytes<32>, s: Bytes<32>): Bytes<32> {
  const verBytes = pad(32, "quest") as Bytes<32>;
  return persistentHash<Vector<5, Bytes<32>>>([verBytes, qId, secret, s, (ver as Uint<32>) as Bytes<32>]);
}

// Circuit to record a quest attestation
// Takes private inputs (witnesses) and publishes only the commitment and nullifier
export circuit recordQuest(nullifierInput: Bytes<32>): [] {
  // Can only record if slot is not set
  assert(!isSet, "Slot already used");
  
  const qId = questId();
  const ver = versionNum();
  const secret = userSecret();
  const s = saltValue();
  
  // Compute commitment as hash of all private inputs
  const comm = computeCommitment(qId, ver, secret, s);
  
  // Record commitment and nullifier on public ledger
  commitment = disclose(comm);
  nullifier = disclose(nullifierInput);
  isSet = true;
  
  // Increment counter
  counter.increment(1);
}

// Circuit for selective disclosure
// User can check if they have a valid attestation for a quest
// without revealing their secret or other details
export circuit checkAttestation(expectedCommitment: Bytes<32>): [] {
  const qId = questId();
  const ver = versionNum();
  const secret = userSecret();
  const s = saltValue();
  
  // Recompute commitment from private inputs
  const comm = computeCommitment(qId, ver, secret, s);
  
  // Assert the computed commitment matches the expected one
  assert(comm == expectedCommitment, "Attestation check failed");
}

// Query circuit to check if a commitment matches the stored one
export circuit hasCommitment(comm: Bytes<32>): Boolean {
  return isSet && (commitment == comm);
}

// Query circuit to check if a nullifier matches the stored one
export circuit hasNullifier(n: Bytes<32>): Boolean {
  return isSet && (nullifier == n);
}

// Query circuit to get current counter value
export circuit getCounterValue(): Field {
  return counter;
}
