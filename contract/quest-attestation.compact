// Quest Attestation Contract for Midnight Network
// Records quest completion on-chain without revealing personal data
// Ledger 8 compatible (Compact 0.31.x)

circuit QuestAttestation {
  // Public ledger state
  // Commitment: hash of (questId, version, userSecret, salt)
  // Stored as a mapping to prevent storage bloat
  ledger mapping(Bytes<32> => Bool) commitments;
  
  // Nullifiers: prevent the same quest from being recorded twice by same user
  ledger mapping(Bytes<32> => Bool) nullifiers;
  
  // Counter: total number of recorded quest attestations
  ledger Uint<32> counter;

  // Circuit to record a quest attestation
  // Takes private inputs (witnesses) and publishes only the commitment and nullifier
  @zk
  circuit recordQuest(
    // Private witnesses - never revealed on chain
    witness Bytes<32> questId,
    witness Uint<16> version,
    witness Bytes<32> userSecret,
    witness Bytes<32> salt,
    witness Bytes<32> nullifier
  ) {
    // Compute commitment as hash of all private inputs
    const commitment: Bytes<32> = hash([questId, version, userSecret, salt]);
    
    // Check nullifier hasn't been used (no double recording)
    assert(!nullifiers[nullifier], "Nullifier already used");
    
    // Record commitment and nullifier on public ledger
    commitments[commitment] = true;
    nullifiers[nullifier] = true;
    
    // Increment counter
    counter = counter + 1u32;
  }

  // Circuit for selective disclosure
  // User can check if they have a valid attestation for a quest
  // without revealing their secret or other details
  @zk
  circuit checkAttestation(
    witness Bytes<32> questId,
    witness Uint<16> version,
    witness Bytes<32> userSecret,
    witness Bytes<32> salt,
    public Bool expectedResult
  ) {
    // Recompute commitment from private inputs
    const commitment: Bytes<32> = hash([questId, version, userSecret, salt]);
    
    // Check if commitment exists on ledger
    const exists: Bool = commitments[commitment];
    
    // Assert the check result matches expectation
    assert(exists == expectedResult, "Attestation check failed");
  }

  // Query circuit to check if a commitment exists (public check)
  circuit hasCommitment(public Bytes<32> commitment) -> Bool {
    return commitments[commitment];
  }

  // Query circuit to check if a nullifier has been used
  circuit hasNullifier(public Bytes<32> nullifier) -> Bool {
    return nullifiers[nullifier];
  }

  // Query circuit to get current counter value
  circuit getCounter() -> Uint<32> {
    return counter;
  }
}
